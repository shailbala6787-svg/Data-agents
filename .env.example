# Baseline agent — environment.
# Copy to .env and set exactly ONE provider key. The provider is auto-detected
# from whichever key is set (or force it with AGENT_LLM_PROVIDER).
# .env is gitignored and is the ONLY manual setup step. Never commit real keys.

# --- Database (defaults to a local SQLite file; set a Postgres URL for production) ---
AGENT_DATABASE_URL=sqlite:///./data/app.db

# --- LLM provider: ollama | auto | anthropic | gemini | openrouter ---
# Default is "ollama" for privacy-first on-premises deployment.
AGENT_LLM_PROVIDER=ollama
AGENT_LLM_MODEL=
# Ollama endpoint (when AGENT_LLM_PROVIDER=ollama).
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=llama3.2:3b

# --- MsSQL credential encryption (recommended for production) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
# Leave blank for dev — credentials stored as plaintext in SQLite.
AGENT_FERNET_KEY=

# Set ONE of the following only if NOT using ollama:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

AGENT_OPENROUTER_API_KEY=

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO

# --- CSV upload ---
# Maximum CSV upload size in bytes (default: 524288000 = 500 MB)
AGENT_CSV_MAX_BYTES=524288000
